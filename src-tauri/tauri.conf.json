{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RouxFlow",
  "version": "0.1.7",
  "identifier": "app.rouxflow.desktop",
  "build": {
    "frontendDist": "../apps/frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter frontend dev",
    "beforeBuildCommand": "pnpm --filter frontend build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RouxFlow",
        "width": 1600,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 RouxFlow Team",
    "shortDescription": "Smart Bluetooth Rubik's Cube Trainer",
    "longDescription": "RouxFlow is a modern speedcubing trainer designed specifically for the Roux method. Connect your Bluetooth smart cube and get real-time phase analysis, scramble validation, and detailed solve statistics."
  },
  "plugins": {
    "deep-link": {
      "schemes": [
        "rouxflow"
      ]
    }
  }
}