{
  "name": "frontend",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "build:wasm:core": "wasm-pack build ../../crates/rouxflow-core --target web --out-dir ../../apps/frontend/src/wasm/rouxflow-core",
    "build:wasm:cloud": "wasm-pack build ../../crates/rouxflow-storage-cloud --target web --out-dir ../../apps/frontend/src/wasm/rouxflow-storage-cloud",
    "build:wasm:render": "wasm-pack build ../../crates/rouxflow-render --target web --out-dir ../../apps/frontend/src/wasm/rouxflow-render",
    "build:wasm": "pnpm run build:wasm:core && pnpm run build:wasm:cloud && pnpm run build:wasm:render",
    "dev": "pnpm run build:wasm && vite",
    "build": "pnpm run build:wasm && vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.93.3",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-deep-link": "^2.4.6",
    "@tauri-apps/plugin-shell": "^2.3.4",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "pinia": "^3.0.4",
    "uuid": "^13.0.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  }
}